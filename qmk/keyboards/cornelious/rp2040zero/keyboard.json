{
    "keyboard_name": "Cornelious RP2040-Zero",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",
    "usb": {
        "pid": "0xC0E1"
    },
    "features": {
        "rgblight": true
    },
    "ws2812": {
        "pin": "GP16",
        "driver": "vendor"
    },
    "rgblight": {
        "driver": "ws2812",
        "led_count": 1,
        "max_brightness": 40,
        "default": {
            "animation": "static_light",
            "hue": 110,
            "sat": 180,
            "val": 36
        }
    }
}
